# Supabase
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat
EXPO_PUBLIC_RC_GOOGLE_API_KEY=
EXPO_PUBLIC_RC_APPLE_API_KEY=
EXPO_PUBLIC_RC_ENTITLEMENT_ID=pro

# Google Sign-In
# Web Client ID is used by both platforms to obtain the Supabase-compatible id token.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS-only: iOS OAuth Client ID from Google Cloud Console (type: iOS).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# iOS-only: reversed iOS client id (same value as REVERSED_CLIENT_ID from GoogleService-Info.plist,
# e.g. com.googleusercontent.apps.XXXXXXXXXXXX-yyyyyy). Required so the native plugin can
# register the OAuth redirect URL scheme in Info.plist during prebuild.
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=

# Meta / Facebook SDK
# Used for Meta Ads Manager app install attribution and app events.
EXPO_PUBLIC_META_APP_ID=
EXPO_PUBLIC_META_CLIENT_TOKEN=
EXPO_PUBLIC_META_DISPLAY_NAME=eTefter
EXPO_PUBLIC_META_AUTO_LOG_APP_EVENTS=true
EXPO_PUBLIC_META_ADVERTISER_ID_COLLECTION=true
EXPO_PUBLIC_META_IOS_TRACKING_PERMISSION=eTefter koristi ovaj identifikator za merenje instalacija i performansi oglasa.
